# Entorno de DESARROLLO. Para desarrollar: cp .env.desarrollo .env
# Estos valores son públicos: no sirven para operar, y el sistema no los acepta fuera de desarrollo.
# El entorno de operación lo genera operacion/entorno.sh.

# Lo dice expresamente: sin esta línea, las claves de abajo detienen el arranque.
MODO=desarrollo

# Administración de la base (migraciones, consola, respaldos).
BD_CLAVE=desarrollo
BD_PUERTO=54329

# Usuario con que la aplicación se conecta. Cambiar la clave aquí y volver a levantar la aplica.
WEB_BD_CLAVE=desarrollo_web

# Puerto de la aplicación en esta máquina: http://localhost:3210
WEB_PUERTO=3210

# Con esta clave se sella la cookie que identifica a cada equipo.
SESION_CLAVE=solo-para-desarrollo-cambiar-antes-de-usar-en-serio

# 1 cuando la aplicación se sirve por HTTPS: la cookie solo viaja cifrada.
COOKIE_SEGURA=0

# El nombre que encabeza el comprobante.
NEGOCIO_NOMBRE=Recicladora

# Desde qué direcciones se usa la aplicación, separadas por coma. Una petición que escribe y no
# viene de una de ellas se rechaza.
ORIGEN=http://localhost:3210,http://127.0.0.1:3210
