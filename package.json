{
  "name": "feruga-sistema",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bd": "docker compose up -d --wait db",
    "bd:parar": "docker compose down",
    "bd:borrar": "docker compose down --volumes",
    "migrar": "node db/migrar.ts",
    "plantilla": "node db/plantilla.ts",
    "test": "node db/plantilla.ts && node --test --test-concurrency=1 \"pruebas/*.test.ts\"",
    "tipos": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "construir": "next build",
    "desarrollo": "next dev"
  },
  "dependencies": {
    "@ios27_design_system/tokens": "1.0.2",
    "iron-session": "9.0.1",
    "next": "16.3.8",
    "pg": "^8.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^5.8.0"
  }
}
